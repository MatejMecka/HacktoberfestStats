{
    "env": {
        "node": true,
	    "es6": true
    },
    "extends": "eslint:recommended",
    "rules": {
        "indent": [
            "error",
            2
        ],
        "linebreak-style": [
            "error",
            "unix"
        ],
        "quotes": [
            "error",
            "single"
        ],
        "semi": [
            "error",
            "never"
        ]
    },
    "parserOptions": {
        "sourceType": "module",
        "ecmaVersion": 2020
    }
}
